{
  "name": "fitcounter-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "dev:pwa": "npm run dev -w @fitcounter/pwa",
    "dev:mobile": "npm run start -w @fitcounter/mobile",
    "build:pwa": "npm run build -w @fitcounter/pwa",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @fitcounter/pwa",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "lefthook": "^1.10.0",
    "typescript": "~5.8.2"
  },
  "dependencies": {
    "react-native-svg": "^15.15.3"
  }
}
