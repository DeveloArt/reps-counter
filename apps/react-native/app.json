{
  "expo": {
    "name": "FitCounter",
    "slug": "reps-counter",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "fitcounter",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },

    "splash": {
      "backgroundColor": "#0D5D5D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fitcounter.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D5D5D"
      },
      "package": "com.fitcounter.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to use Face ID."
        }
      ],
      "expo-updates",
      "expo-build-properties"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "507f8d24-d599-4adc-ae0b-a5e453d57ae3"
      }
    },
    "owner": "develo_art"
  }
}
