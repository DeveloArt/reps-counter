{
  "expo": {
    "name": "FitCounter",
    "slug": "fitcounter",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "fitcounter",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/YOUR_PROJECT_ID"
    },
    "splash": {
      "backgroundColor": "#0D5D5D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fitcounter.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D5D5D"
      },
      "package": "com.fitcounter.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to use Face ID."
        }
      ],
      "expo-updates",
      "@config-plugins/detox",
      "expo-build-properties"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
