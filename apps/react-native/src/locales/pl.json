  "terms": {
    "title": "Warunki Użytkowania",
    "effectiveDate": "Data Obowiązywania",
    "section1": {
      "title": "1. Akceptacja Warunków",
      "content": "Uzyskując dostęp i korzystając z aplikacji FitCounter, zgadzasz się na przestrzeganie niniejszych Warunków Użytkowania."
    },
    "section2": {
      "title": "2. Wyłączenie Odpowiedzialności",
      "content": "FitCounter jest dostarczany „tak jak jest” bez żadnych gwarancji. Nie ponosimy odpowiedzialności za jakiekolwiek szkody, problemy zdrowotne lub utratę danych wynikające z korzystania z tej aplikacji. Używasz jej na własne ryzyko."
    },
    "section3": {
      "title": "3. Przechowywanie Danych",
      "content": "Wszystkie dane są przechowywane lokalnie na Twoim urządzeniu. Nie przesyłamy, nie przechowujemy ani nie przetwarzamy Twoich danych osobowych na zewnętrznych serwerach."
    },
    "section4": {
      "title": "4. Rozstrzyganie Sporów",
      "content": "Wszelkie spory wynikające z korzystania z tej aplikacji będą rozstrzygane wyłącznie przez właściwe sądy w Gdańsku, Polska."
    },
    "section5": {
      "title": "5. Zmiany Warunków",
      "content": "Zastrzegamy sobie prawo do zmiany niniejszych warunków w dowolnym momencie. Dalsze korzystanie z aplikacji oznacza akceptację nowych warunków."
    }
  },
  "privacy": {
    "title": "Polityka Prywatności",
    "effectiveDate": "Data Obowiązywania",
    "section1": {
      "title": "1. Gromadzenie Danych",
      "content": "FitCounter nie gromadzi, nie przesyła ani nie udostępnia żadnych danych osobowych. Aplikacja działa całkowicie offline."
    },
    "section2": {
      "title": "2. Lokalne Przechowywanie",
      "content": "Wszystkie dzienniki treningowe, cele i ustawienia są przechowywane lokalnie w pamięci Twojego urządzenia (IndexedDB/LocalStorage). Masz pełną kontrolę nad swoimi danymi."
    },
    "section3": {
      "title": "3. Brak Udostępniania Osobom Trzecim",
      "content": "Ponieważ nie gromadzimy danych, nie udostępniamy żadnych danych osobom trzecim, reklamodawcom ani dostawcom analityki."
    },
    "section4": {
      "title": "4. Bezpieczeństwo Danych",
      "content": "Twoje dane pozostają na Twoim urządzeniu. Zalecamy zabezpieczenie urządzenia kodem dostępu lub biometrią w celu ochrony informacji."
    },
    "section5": {
      "title": "5. Kontakt",
      "content": "Jeśli masz jakiekolwiek pytania dotyczące tej Polityki Prywatności, skontaktuj się z nami."
    }
  }
}
