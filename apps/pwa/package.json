{
  "name": "@fitcounter/pwa",
  "version": "1.0.0",
  "private": true,
  "description": "Główna aplikacja PWA (React + Vite)",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
